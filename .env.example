# (Opsional) Path kustom ke database 9Router lokal jika tidak menggunakan path default
# Default Windows: %APPDATA%\9router\db\data.sqlite (C:\Users\YOUR_USERNAME\AppData\Roaming\9router\db\data.sqlite)
# Default Linux/macOS: ~/.9router/db/data.sqlite
# YOUR_9ROUTER_DB_PATH=C:\Users\YOUR_USERNAME\AppData\Roaming\9router\db\data.sqlite
